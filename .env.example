"""Environment variables configuration."""

# Django Configuration
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration - PostgreSQL for BOTH development and production
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=fuel_routing_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432


# Production Database (override values above)
# DB_NAME=fuel_routing_prod
# DB_USER=prod_user
# DB_PASSWORD=secure-password-here
# DB_HOST=prod-db.example.com
# DB_PORT=5432

# Google Maps API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Redis Cache (optional — default is in-memory LocMemCache; enables cross-worker sharing)
# REDIS_ENABLED=True
# REDIS_URL=redis://127.0.0.1:6379/1

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Fuel Routing Configuration
VEHICLE_FUEL_EFFICIENCY=10
MAX_VEHICLE_RANGE=500
FUEL_TANK_CAPACITY_GALLONS=50
